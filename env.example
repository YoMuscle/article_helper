# Flask 密鑰（請使用隨機字串）
SECRET_KEY=your-secret-key-change-this-in-production

# 資料庫配置
# 本地開發：sqlite:///apa_checker.db
# 雲端部署：postgresql://user:pass@host:port/dbname
DATABASE_URL=sqlite:///apa_checker.db

# Email (SMTP) 配置
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Google OAuth 配置
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== 應用配置 =====
# 本地開發：http://localhost:5000
# 雲端部署：https://your-app-name.onrender.com 或 https://your-domain.com
APP_URL=http://localhost:5000

# 伺服器配置
# HOST: 本地用 127.0.0.1，雲端用 0.0.0.0
# PORT: 雲端平台會自動設定（Render、Heroku 等會提供 PORT 環境變數）
HOST=0.0.0.0
PORT=5000

# 開發模式（設為 True 時自動驗證新註冊使用者，無需 email 驗證）
DEV_MODE=True

# Flask Debug 模式（雲端部署請設為 False）
FLASK_DEBUG=True

# ===== 管理員與會員設定 =====
# 管理員 Email（逗號分隔，可存取管理 API）
ADMIN_EMAILS=admin@example.com

# 自動升級為 Premium 的 Email（逗號分隔，啟動時自動升級）
PREMIUM_EMAILS=vip1@example.com,vip2@example.com

